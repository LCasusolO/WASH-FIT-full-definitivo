{
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/platform-report.js": {
      "maxDuration": 60,
      "includeFiles": "js/data/indicators.js"
    },
    "api/drive-archive.js": {
      "maxDuration": 60
    },
    "api/chrome-report.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
